      "source": [
        "//import & clean data"
      ],
      "metadata": {
        "id": "JDqT412kcqAa"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "categorical_cols = df.select_dtypes(include='object').columns.tolist()\n",
        "categorical_cols.remove('customerID')\n",
        "categorical_cols.remove('Churn')\n",
        "\n",
        "df['Churn_binary'] = df['Churn'].map({'Yes': 1, 'No': 0})\n",
        "\n",
        "for col in categorical_cols:\n",
        "    print(col, '→', df[col].nunique(), 'categories:', df[col].unique())\n",
        "\n",
        "addon_cols = ['OnlineSecurity', 'OnlineBackup', 'DeviceProtection',\n",
        "              'TechSupport', 'StreamingTV', 'StreamingMovies']\n",
        "for col in addon_cols:\n",
        "    df[col] = df[col].replace('No internet service', 'No')\n",
        "\n",
        "df['MultipleLines'] = df['MultipleLines'].replace('No phone service', 'No')\n",
        "\n",
        "binary_cols = ['gender', 'Partner', 'Dependents', 'PhoneService', 'PaperlessBilling',\n",
        "               'MultipleLines', 'OnlineSecurity', 'OnlineBackup', 'DeviceProtection',\n",
        "               'TechSupport', 'StreamingTV', 'StreamingMovies']\n",
        "\n",
        "for col in binary_cols:\n",
        "    if col == 'gender':\n",
        "        df[col] = df[col].map({'Female': 1, 'Male': 0})\n",
        "    else:\n",
        "        df[col] = df[col].map({'Yes': 1, 'No': 0})\n",
        "\n",
        "cols_to_dummy = ['InternetService', 'Contract', 'PaymentMethod']\n",
        "existing_cols_to_dummy = [col for col in cols_to_dummy if col in df.columns]\n",
        "\n",
        "if existing_cols_to_dummy:\n",
        "    df = pd.get_dummies(df, columns=existing_cols_to_dummy, drop_first=True)\n",
        "\n",
        "df.info()"
      ],
