        "import statsmodels.api as sm\n",
        "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
        "\n",
        "def calculate_vif(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    excluded_cols = ['customerID', 'Churn', 'Churn_binary']\n",
        "    predictor_cols = [col for col in df.columns if col not in excluded_cols]\n",
        "    X = df[predictor_cols].astype(float)\n",
        "    X_const = sm.add_constant(X)\n",
        "\n",
        "    vif_data = []\n",
        "    for i in range(X_const.shape[1]):\n",
        "        feature_name = X_const.columns[i]\n",
        "        vif_value = variance_inflation_factor(X_const.values, i)\n",
        "        vif_data.append({'feature': feature_name, 'VIF': vif_value})\n",
        "\n",
        "    vif_df = pd.DataFrame(vif_data)\n",
        "    vif_df = vif_df[vif_df['feature'] != 'const']\n",
        "    vif_df = vif_df.sort_values(by='VIF', ascending=False).reset_index(drop=True)\n",
        "    return vif_df\n",
        "\n",
        "vif_results = calculate_vif(df)\n",
        "vif_results\n",
        "\n",
        "df_v2 = df.drop(columns=['MonthlyCharges'])\n",
        "vif_results_v2 = calculate_vif(df_v2)\n",
        "vif_results_v2\n",
        "\n",
        "df_v3 = df.drop(columns=['MonthlyCharges', 'TotalCharges'])\n",
        "vif_results_v3 = calculate_vif(df_v3)\n",
        "vif_results_v3"
